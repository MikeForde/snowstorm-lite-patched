{
  "name": "snowstorm-lite",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Snowstorm Lite",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "MAVEN_OPTS": "-Xmx1g"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },
  "mounts": [
    "source=snowstorm-lite-maven-cache,target=/home/vscode/.m2,type=volume"
  ],
  "postCreateCommand": "bash -lc 'export OPENCODE_INSTALL_DIR=/home/vscode/.local/bin && curl -fsSL https://opencode.ai/install | bash && mvn -DskipTests compile'",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot"
      ]
    }
  }
}
